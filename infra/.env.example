AWS_DEFAULT_REGION=us-east-1
# LocalStack-only credentials. Never replace these with real AWS credentials.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SPRING_PROFILES_ACTIVE=compose
# API pública real usada pela API e pelo handler de operações do starter.
POKEAPI_BASE_URL=https://pokeapi.co/api/v2
WOBBUFFE_ROUTING_ENABLED=true
WOBBUFFE_SQS_ENDPOINT=http://localstack:4566
WOBBUFFE_SQS_QUEUE_URL=http://localstack:4566/queue/us-east-1/000000000000/wobbuffe-operations
WOBBUFFE_CONSUMER_ENABLED=true
WOBBUFFE_CONSUMER_QUEUE_URL=http://localstack:4566/queue/us-east-1/000000000000/wobbuffe-operations
WOBBUFFE_CONSUMER_DLQ_URL=http://localstack:4566/queue/us-east-1/000000000000/wobbuffe-operations-dlq
WOBBUFFE_CONSUMER_POLL_WAIT_SECONDS=20
WOBBUFFE_CONSUMER_BATCH_SIZE=5
WOBBUFFE_CONSUMER_VISIBILITY_TIMEOUT_SECONDS=90
WOBBUFFE_CONSUMER_MAX_RECEIVE_COUNT=5
WOBBUFFE_CONSUMER_MAX_CONCURRENCY=2
WOBBUFFE_CONSUMER_RATE_LIMIT_PER_SECOND=5
